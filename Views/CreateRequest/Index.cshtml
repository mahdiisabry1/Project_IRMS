@{
    ViewBag.Title = "Create Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Session["Username"] as string;
    var Role = Session["Role"] as string;
}


@section CustomPageStyles {
    <link href="~/Content/CreateRequest/CreateRequest.css" rel="stylesheet" />

}



<!-- Main content -->
<section class="content pt-3 d-flex justify-content-center align-items-center" style="height: 100% !important;">
    <div id="successDiv" class="position-absolute" style="z-index: 100;">
        <div class="bg-white border border-3 rounded p-5">
            <div class="d-flex justify-content-center pb-4">
                <img src="~/Images/createdIcon.png" />
            </div>
            <div class="text-center text-green">
                <h2 class="">Successfully Created !</h2>
            </div>
            <div class="text-center">
                <p class="mb-0">The Request has been created succefully</p>
                <p class="">You can send it to the division now or later</p>
            </div>
            <div class="d-flex align-items-center justify-content-center">
                <button class="pr-3 pl-3 rounded bg-green border">Send</button>
                <button  id="laterButton" class="pr-3 pl-3 rounded bg-red border">Continue without sending</button>
            </div>
        </div>
    </div>
    <div id="errorDiv" class="alert alert-danger position-absolute" style="display: none; z-index: 100;">
        <p>Error: </p>
    </div>
    <div class="container-fluid">
        <!-- SELECT2 EXAMPLE -->
        <div class="card-default">
            <div class="card-header border-bottom-0 pb-0  ">
                <h3 class="card-title">Create Requests</h3>
            </div>
            <!-- /.card-header -->
            <form enctype="multipart/form-data" id="myForm">
                <div class=" pt-0 mt-0">
                    <div class="row">
                        <div class="col-12 col-sm-9">
                            <hr />
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label>First Name</label>
                                        <input type="text" class="form-control" id="firstName" name="firstName" placeholder="Enter First Name" style="width:100%;  " />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label>Last Name</label>
                                        <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Enter Last Name" style="width: 100%;  " />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->

                            </div>
                            <!-- /.row -->
                            <div class="row">
                                <div class="col-12 col-sm-10">
                                    <div class="form-group">
                                        <label>University</label>
                                        <input type="text"
                                               id="university"
                                               class="form-control w-100 searchInput"
                                               name="University"
                                               placeholder="University Name"
                                               autocomplete="off" />
                                        <ul id="dropdownList" class="list-group position-absolute w-100" style="z-index: 1000; display: none;"></ul>
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-2">
                                    <div class="form-group">
                                        <label>Gender</label>
                                        <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                                            <label class="btn btn-outline-secondary active">
                                                <input type="radio" name="gender" id="male" autocomplete="off" onchange="updateProfileImage()" checked/> Male
                                            </label>
                                            <label class="btn btn-outline-secondary">
                                                <input type="radio" name="gender" id="female" autocomplete="off" onchange="updateProfileImage()" /> Female
                                            </label>
                                        </div>
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="email">Personal Email</label>
                                        <input type="email" class="form-control" id="email" name="email" placeholder="Enter Email" />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="contactNo">Contact No</label>
                                        <input type="text" class="form-control" id="contactNo" name="contactNo" placeholder="Enter Contact Number" />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="degree">Degree</label>
                                        <div class="input-group">
                                            <select class="form-control" id="degreeType" name="degreeType" style="max-width: 75px;">
                                                <option selected disabled>Type</option>
                                                <option value="BSc">BSc</option>
                                                <option value="BA">BA</option>
                                                <option value="BEng">BEng</option>
                                                <option value="MSc">MSc</option>
                                                <option value="MA">MA</option>
                                                <option value="PhD">PhD</option>
                                                <option value="BBA">BBA</option>
                                                <option value="LLB">LLB</option>
                                                <option value="MBA">MBA</option>
                                                <option value="MEng">MEng</option>
                                                <option value="MD">MD</option>
                                                <option value="JD">JD</option>
                                                <option value="DPhil">DPhil</option>
                                                <option value="EdD">EdD</option>
                                                <option value="DBA">DBA</option>
                                                <option value="Diploma">Diploma</option>
                                                <option value="Certificate">Certificate</option>
                                                <option value="Associate">Associate</option>
                                            </select>
                                            <input type="text" class="form-control" id="degreeName" name="degreeName" placeholder="Degree Name" autocomplete="off" />
                                        </div>
                                        <ul class="list-group" id="suggestions" style="max-height: 150px; overflow-y: auto; position: absolute; z-index: 1000; display: none;"></ul>
                                        <input type="text" class="form-text text-decoration-none border-0 focus-none w-100" id="degree" name="degree" style="outline: none; cursor: default; font-size: 12px; background-color: #f4f6f9;" readonly />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        @if (Role == "HR")
                                        {
                                            <label for="division">Division</label>
                                        }
                                        else if (Role == "IT")
                                        {
                                            <label for="division">Department</label>

                                        }

                                        <select class="form-control" id="division" name="division">
                                            @if (Role == "HR")
                                            {
                                                <option disabled>HR Division</option>
                                                <option>AGS - Airport & Ground Service</option>
                                                <option>CS - Cabin Service</option>
                                                <option>CGO - Cargo</option>
                                                <option>CO - Corporate Offices</option>
                                                <option>ENG - Engineering</option>
                                                <option>FIN - Finance</option>
                                                <option>FO - Flight Operation</option>
                                                <option>HR - Human Resource</option>
                                                <option value="IT">IT - Information Technology</option>
                                                <option>LP - Logistics and properties</option>
                                                <option>MAR - Marketing</option>
                                                <option>RMP - Revenue Management & Planning</option>
                                                <option>SO - Security Operations</option>
                                                <option>SAC - SriLankan Aviation College</option>
                                                <option>WSD - Worldwide Sales and Distribution</option>
                                            }
                                            else if (Role == "IT")
                                            {
                                                <option disabled>IT Department</option>
                                                <option>DT&ITBR - Digital Transformation & IT Business Relations</option>
                                                <option>GDP&C - Graph Data Protection & Compliance</option>
                                                <option>ITBS - IT Business System</option>
                                                <option>ITO&SM - IT Operations & Services Management</option>
                                                <option>ITPS&CS - IT Passenger Service & Cargo System</option>
                                                <option>ITP&SI - IT Projects & System Integration</option>
                                                <option>OHIT - Office of Head of Information Technology</option>
                                            }
                                            else
                                            {
                                                <option selected>Select Division</option>
                                            }
                                        </select>
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                            </div>
                        </div>
                        <!--to add the profile card-->
                        <div class="col-12 col-sm-3  pt-2">
                            <div class="card shadow border-0 h-100">
                                <!--imgupload-->
                                <div class="box-card bg-dark position-relative d-flex justify-content-center align-items-center">
                                    <!-- Profile image -->
                                    <img id="profileImage"
                                         alt="Profile icon"
                                         class="rounded-circle position-absolute"
                                         src="/Images/Group 1000002769.png?1742784561998"
                                         onclick="document.getElementById('imageUpload').click()"
                                         style="cursor: pointer;" />

                                    <!-- Hidden file input -->
                                    <input type="file"
                                           id="imageUpload"
                                           name="profileImage"
                                           class="d-none"
                                           accept="image/*"
                                           onchange="previewImage(event)" />
                                </div>
                                <!--end-->
                                <div class="card-body text-center d-flex flex-column justify-content-center p-0">
                                    <h5 class="text-secondary">Upload CV Here</h5>

                                    <!-- Upload Box for the CV file -->
                                    <div class="upload-box bg-light d-flex flex-column align-items-center justify-content-center dropzone"
                                         id="uploadBox"
                                         onclick="document.getElementById('cvUpload').click();">
                                        <div class="dz-message">
                                            <i class="fas fa-upload"></i>
                                            <p class="text-secondary">Choose a file or drag & drop it here</p>
                                        </div>
                                    </div>

                                    <!-- Hidden File Input for CV -->
                                    <input type="file"
                                           id="cvUpload"
                                           name="cvFile"
                                           class="d-none"
                                           accept=".pdf, .docx, .doc, .txt"
                                           onchange="previewCV(event)" />
                                    <!-- Preview Container for CV -->
                                    <div id="filePreviewContainer">
                                        <!-- Preview will be shown here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.card-body -->
                <div id="formMessage"></div>
                <div class="card-footer d-flex justify-content-end" style="background-color: #f4f6f9;">
                    <button type="submit" class="btn btn-custom">Create Request</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts{
    <script src="~/Scripts/PageScript/CreateRequest.js" type="text/javascript"></script>
}