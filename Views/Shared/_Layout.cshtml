<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IRMS</title>
    <!-- Added Font Awesome for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("CustomPageStyles",required:false)
    <!-- Link custom CSS file -->
    <link href="~/Content/MainCSS/Site.css" rel="stylesheet" />
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-footer-fixed layout-navbar-fixed">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <!-- Sidebar toggle button -->
                    <a class="nav-link" href="#"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <!-- Display current page title dynamically -->
                    <a href="#" class="nav-link">@ViewBag.Title</a>
                </li>
            </ul>
            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!-- User information dropdown -->
                <li class="nav-item dropdown no-arrow">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button"
                       data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="text-container mr-2 d-none d-lg-inline text-gray-600 small">
                            Isuru Perera
                            <span class="text-gray-500 small d-block">(Human Resource)</span>
                        </span>
                        <!-- User profile picture -->
                        <img class="img-profile rounded-circle" src="~/Images/profilepic.png" alt="User Profile Picture">
                    </a>
                    <!-- User dropdown menu -->
                    <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                         aria-labelledby="userDropdown">
                        <a class="dropdown-item" href="#">
                            <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                            Profile
                        </a>
                        <a class="dropdown-item" href="#">
                            <i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i>
                            Settings
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                            <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                            Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar elevation-4" id="accordionSidebar">
            <!-- Added brand link with a logo -->
            <a href="../../index3.html" class="brand-link d-flex align-items-center mt-1">
                <img src="~/Images/LogoIcon.png" alt="Logo Icon" style="width: 70px; height: 70px !important; object-fit: contain;">
                <span class="brand-text font-weight-light">
                    <img alt="SriLankan Airlines Logo" src="~/Images/Logo2.png" style="width: 150px;">
                </span>
            </a>
            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="sidebar-menu mt-lg-5">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="~/Home/Index" class="nav-link @(ViewBag.ActivePage == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <!-- Added Requests section -->
                        <li class="nav-item has-treeview @(ViewContext.RouteData.Values["Controller"].ToString() == "CreateRequest" || ViewContext.RouteData.Values["Controller"].ToString() == "ViewRequest" ? "active" : "")" id="Request">
                            <div class="nav-link">
                                <i class="nav-icon fa-solid fa-code-pull-request"></i>
                                <p>
                                    Requests
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </div>
                            <ul class="nav nav-treeview">
                                <li class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "CreateRequest" ? "active" : "")" onclick="window.location.href='@Url.Action("Index", "CreateRequest")'">
                                    <a class="nav-link" href="#">
                                        <i class="fa-solid fa-chevron-right nav-icon"></i>
                                        <p>Create Requests</p>
                                    </a>
                                </li>
                                <li class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "ViewRequest" ? "active" : "")" onclick="window.location.href='@Url.Action("Index", "ViewRequest")'">
                                    <a class="nav-link" href="#">
                                        <i class="fa-solid fa-chevron-right nav-icon"></i>
                                        <p>View Requests</p>
                                    </a>
                                </li>
                                <li class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "ApprovedRequest" ? "active" : "")" onclick="window.location.href='@Url.Action("Index", "ApprovedRequest")'">
                                   <a class="nav-link" href="#">
                                        <i class="fa-solid fa-chevron-right nav-icon"></i>
                                        <p>Approved Requests</p>
                                    </a>
                                </li>
                                <li class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "SentRequest" ? "active" : "")" onclick="window.location.href='@Url.Action("Index", "SentRequest")'">
                                    <a class="nav-link" href="#">
                                        <i class="fa-solid fa-chevron-right nav-icon"></i>
                                        <p>Sent Requests</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <!-- Added User Profiles section -->
                        <li class="nav-item">
                            <a href="#" class="nav-link @(ViewBag.ActivePage == "UserProfiles" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-user"></i>
                                <p>User Profiles</p>
                            </a>
                        </li>
                        <!-- Added Task Management section -->
                        <li class="nav-item">
                            <a href="~/TaskManagement/Index" class="nav-link @(ViewBag.ActivePage == "TaskManagement" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-list-check"></i>
                                <p>Task Management</p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
            <div class="sidebar-footer mt-auto p-3">
                <!-- Footer logo -->
                <a href="#" class="d-flex align-items-center">
                    <img src="~/Images/Srilankan-white 1.png" alt="Logo Icon">
                </a>
            </div>
        </aside>
        <!-- /.control-sidebar -->
        <!-- Content Wrapper -->
        <div class="content-wrapper">
            @RenderBody()
        </div>
        <!-- Main Footer -->
        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Ⓒ 2024 SriLankan IT Systems. All rights reserved</b> 
            </div>
        </footer>
    </div>
    <!-- Added script references -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <!-- Fixed incorrect attribute for JavaScript file -->
    <script src="~/Scripts/MainJS/Site.js"></script>
</body>
</html>
