@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Specify the path to your layout file
    ViewBag.Title = "Sent Requests"; // Set the page title
}

<!-- Main Content -->
<div class="content-wrapper">
    <div class="flex-grow-1 bg-light p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="m-0">Sent Requests</h4>
            <div class="d-flex align-items-center gap-3">
                <div class="input-group" style="width: 250px;">
                    <input type="text" class="form-control" placeholder="Search">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light rounded-circle" data-bs-toggle="dropdown">
                        <img src="/api/placeholder/32/32" alt="User" class="rounded-circle" style="width: 32px; height: 32px;" />
                    </button>
                </div>  
            </div>
        </div>

        <!-- Grid of Cards -->
        <div class="row g-4">
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="flex-shrink-0">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                        <i class="fas fa-user text-primary fs-4"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">InternDisplayName</h6>
                                    <p class="text-muted small mb-0">DisplayName - Initials</p>
                                    <p class="text-muted small mb-0">DivisionName</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <span class="badge bg-success rounded-pill">Status</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            
        </div>
    </div>
</div>