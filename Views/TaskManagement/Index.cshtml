<!DOCTYPE html>
<html lang="en">
<head>
    <title>Task Management</title>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Main Form -->
            <div class="col-md-12 p-3">
                <div class="card card-primary">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title">Add New Task</h3>
                    </div>
                    <!-- /.card-header -->
                    <!-- Form start -->
                    <form class="form-horizontal">
                        <div class="card-body">
                            <!-- Main Task Section -->
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-md-6">
                                    <!-- Project Name -->
                                    <div class="form-group row">
                                        <label for="inputProjectName" class="col-sm-4 col-form-label">Project Name</label>
                                        <div class="col-sm-8">
                                            <input type="text"
                                                   class="form-control"
                                                   id="inputProjectName"
                                                   placeholder="Enter Project Name" />
                                        </div>
                                    </div>

                                    <!-- Assignees (Dropdown) -->
                                    <div class="form-group row">
                                        <label for="selectAssignees" class="col-sm-4 col-form-label">Assignees</label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="selectAssignees">
                                                <option>Vimukthi Manchanayake</option>
                                                <option>Shenuka Fernando</option>
                                                <option>Dishani Kulasekara</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Start Date -->
                                    <div class="form-group row">
                                        <label for="inputStartDate" class="col-sm-4 col-form-label">Start Date</label>
                                        <div class="col-sm-8">
                                            <input type="date"
                                                   class="form-control"
                                                   id="inputStartDate" />
                                        </div>
                                    </div>

                                    <!-- End Date -->
                                    <div class="form-group row">
                                        <label for="inputEndDate" class="col-sm-4 col-form-label">End Date</label>
                                        <div class="col-sm-8">
                                            <input type="date"
                                                   class="form-control"
                                                   id="inputEndDate" />
                                        </div>
                                    </div>

                                    <!-- Supervisor (Dropdown) -->
                                    <div class="form-group row">
                                        <label for="selectSupervisor" class="col-sm-4 col-form-label">Supervisor</label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="selectSupervisor">
                                                <option>Kusal Lankathilaka</option>
                                                <option>Pawan Sadaruan</option>
                                                <option>Nisitha Dilshan</option>
                                                <option>Keerthi Ekanayake</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <!-- /.Left Column -->
                                <!-- Right Column -->
                                <div class="col-md-6">
                                    <!-- Description Box -->
                                    <div class="form-group">
                                        <label for="textareaDescription">Description</label>
                                        <textarea class="form-control"
                                                  id="textareaDescription"
                                                  rows="8"
                                                  placeholder="Enter task description here..."></textarea>
                                    </div>
                                </div>
                                <!-- /.Right Column -->
                            </div>
                            <!-- /.row -->
                            <!-- Done Button -->
                            <div class="row mt-4">
                                <div class="col-md-12 text-right">
                                    <button type="button" class="btn btn-success">Done</button>
                                </div>
                            </div>
                            <!-- /.Done Button -->
                            <!-- Sub Task Section -->
                            <div class="mt-4">
                                <h4>Sub Tasks</h4>
                                <div class="row">
                                    <!-- Left Column -->
                                    <div class="col-md-6">
                                        <!-- Sub Task Name -->
                                        <div class="form-group row">
                                            <label for="inputSubTaskName" class="col-sm-4 col-form-label">Sub Task Name</label>
                                            <div class="col-sm-8">
                                                <input type="text"
                                                       class="form-control"
                                                       id="inputSubTaskName"
                                                       placeholder="Enter Sub Task Name" />
                                            </div>
                                        </div>

                                        <!-- Assignees (Dropdown) -->
                                        <div class="form-group row">
                                            <label for="selectSubTaskAssignees" class="col-sm-4 col-form-label">Assignees</label>
                                            <div class="col-sm-8">
                                                <select class="form-control" id="selectSubTaskAssignees">
                                                    <option>Vimukthi Manchanayake</option>
                                                    <option>Shenuka Fernando</option>
                                                    <option>Dishani Kulasekara</option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Start Date -->
                                        <div class="form-group row">
                                            <label for="inputSubTaskStartDate" class="col-sm-4 col-form-label">Start Date</label>
                                            <div class="col-sm-8">
                                                <input type="date"
                                                       class="form-control"
                                                       id="inputSubTaskStartDate" />
                                            </div>
                                        </div>

                                        <!-- End Date -->
                                        <div class="form-group row">
                                            <label for="inputSubTaskEndDate" class="col-sm-4 col-form-label">End Date</label>
                                            <div class="col-sm-8">
                                                <input type="date"
                                                       class="form-control"
                                                       id="inputSubTaskEndDate" />
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /.Left Column -->
                                    <!-- Right Column -->
                                    <div class="col-md-6">
                                        <!-- Sub Task Description -->
                                        <div class="form-group">
                                            <label for="textareaSubTaskDescription">Description</label>
                                            <textarea class="form-control"
                                                      id="textareaSubTaskDescription"
                                                      rows="8"
                                                      placeholder="Enter sub-task description here..."></textarea>
                                        </div>
                                    </div>
                                    <!-- /.Right Column -->
                                </div>
                                <!-- /.row -->
                                <!-- Done Button for Sub Tasks -->
                                <div class="row mt-4">
                                    <div class="col-md-12 text-right">
                                        <button type="button" class="btn btn-success">Done</button>
                                    </div>
                                </div>
                                <!-- /.Done Button for Sub Tasks -->
                            </div>
                            <!-- /.Sub Task Section -->
                        </div>
                        <!-- /.card-body -->
                        <!-- Submit Button -->
                        <div class="card-footer text-right">
                            <div class="btn-group">
                                <button type="button" class="btn btn-danger" style="margin-right: 10px;">Cancel</button>
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col-md-12 -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="header">
                    <h3 class="card-title">Task Details</h3>
                    <!--Card header-->
                    <div class="card-body table-responsive p-0">
                        <table class="table table-hover text-nowrap">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Projects</th>
                                    <th>Assign</th>
                                    <th>Spervisor</th>
                                    <th>Status</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>01</td>
                                    <td>Intern Request Management System</td>
                                    <td>Vimukthi Manchanayaka, Shenuka Fernando</td>
                                    <td>Pawan Sadaruwan</td>
                                    <td>
                                        <span class="fa-tag tag-sucess">Ongong</span>
                                    </td>
                                    <td>20/10/2024</td>
                                    <td>20/01/2025</td>
                                    <td>
                                        <div class="row mt-1">
                                            <div class="col-md-10 text-center">
                                                <button type="button" class="btn btn-success">Edit</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td>02</td>
                                    <td>GovTra</td>
                                    <td>Nilesh Manchanayaka, Keshan Fernando</td>
                                    <td>Hansini Amarathunga</td>
                                    <td>
                                        <span class="fa-tag tag-sucess">Ongong</span>
                                    </td>
                                    <td>20/10/2024</td>
                                    <td>20/01/2025</td>
                                    <td>
                                        <div class="row mt-1">
                                            <div class="col-md-10 text-center">
                                                <button type="button" class="btn btn-success">Edit</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td>03</td>
                                    <td>Doc Checking</td>
                                    <td>Nimantha Manchanayaka, Keshan Shadshindra</td>
                                    <td>Hansini Kurunasekara</td>
                                    <td>
                                        <span class="fa-tag tag-sucess">Ongong</span>
                                    </td>
                                    <td>02/10/2024</td>
                                    <td>23/01/2025</td>
                                    <td>
                                        <div class="row mt-1">
                                            <div class="col-md-10 text-center">
                                                <button type="button" class="btn btn-success">Edit</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                   
                </div>
            </div>
        </div>
</body>





</html>
