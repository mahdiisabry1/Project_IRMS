<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Management</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/TaskManagement/StyleSheet1.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Main Form -->
            <div class="col-md-12 p-3">
                <div class="card card-primary">
                    <!-- Collapsible Card Header -->
                    <div class="card-header" style="background-color: white; color: black;">
                        <button class="btn w-100 d-flex justify-content-between align-items-center"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#addTaskForm"
                                aria-expanded="false"
                                aria-controls="addTaskForm"
                                style="background-color: white; border: none; color: black; box-shadow: none;">
                            <h3 class="card-title mb-0">Add New Task</h3>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div style="border-top: 5px solid black; margin-top: 10px;"></div> <!-- Black Line -->
                    </div>
                    <!-- Collapsible Form -->
                    <div id="addTaskForm" class="collapse">
                        <form class="form-horizontal">
                            <div class="card-body">
                                <div class="row">
                                    <!-- Left Column -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="inputProjectName" class="form-label">Project Name</label>
                                            <input type="text" class="form-control" id="inputProjectName" placeholder="Enter Project Name">
                                        </div>
                                        <div class="mb-3">
                                            <label for="selectAssignees" class="form-label">Assignees</label>
                                            <select class="form-control" id="selectAssignees">
                                                <option>Vimukthi Manchanayake</option>
                                                <option>Shenuka Fernando</option>
                                                <option>Dishani Kulasekara</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label for="inputStartDate" class="form-label">Start Date</label>
                                            <input type="date" class="form-control" id="inputStartDate">
                                        </div>
                                        <div class="mb-3">
                                            <label for="inputEndDate" class="form-label">End Date</label>
                                            <input type="date" class="form-control" id="inputEndDate">
                                        </div>
                                        <div class="mb-3">
                                            <label for="selectSupervisor" class="form-label">Supervisor</label>
                                            <select class="form-control" id="selectSupervisor">
                                                <option>Kusal Lankathilaka</option>
                                                <option>Pawan Sadaruan</option>
                                                <option>Nisitha Dilshan</option>
                                                <option>Keerthi Ekanayake</option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Right Column -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="textareaDescription" class="form-label">Description</label>
                                            <textarea class="form-control" id="textareaDescription" rows="10" placeholder="Enter task description here..."></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-4">
                                    <div class="col-md-12 text-end">
                                        <button type="button" class="btn btn-success">Done</button>
                                    </div>
                                </div>
                                <!-- Sub Task Section -->
                                <div class="mt-4">
                                    <h4>Sub Tasks</h4>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="inputSubTaskName" class="form-label">Sub Task Name</label>
                                                <input type="text" class="form-control" id="inputSubTaskName" placeholder="Enter Sub Task Name">
                                            </div>
                                            <div class="mb-3">
                                                <label for="selectSubTaskAssignees" class="form-label">Assignees</label>
                                                <select class="form-control" id="selectSubTaskAssignees">
                                                    <option>Vimukthi Manchanayake</option>
                                                    <option>Shenuka Fernando</option>
                                                    <option>Dishani Kulasekara</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label for="inputSubTaskStartDate" class="form-label">Start Date</label>
                                                <input type="date" class="form-control" id="inputSubTaskStartDate">
                                            </div>
                                            <div class="mb-3">
                                                <label for="inputSubTaskEndDate" class="form-label">End Date</label>
                                                <input type="date" class="form-control" id="inputSubTaskEndDate">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="textareaSubTaskDescription" class="form-label">Description</label>
                                                <textarea class="form-control" id="textareaSubTaskDescription" rows="10" placeholder="Enter sub-task description here..."></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-4">
                                        <div class="col-md-12 text-end">
                                            <button type="button" class="btn btn-success">Done</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer text-end">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-danger me-2">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Task Details Table -->
            <div class="col-12 mt-4">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title fw-bold">Task Details</h4>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-hover text-nowrap">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Projects</th>
                                    <th>Assign</th>
                                    <th>Supervisor</th>
                                    <th>Status</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>01</td>
                                    <td>Intern Request Management System</td>
                                    <td>Vimukthi Manchanayaka, Shenuka Fernando</td>
                                    <td>Pawan Sadaruwan</td>
                                    <td><span class="badge bg-success">Ongoing</span></td>
                                    <td>20/10/2024</td>
                                    <td>20/01/2025</td>
                                    <td><button class="btn btn-success btn-sm">Edit</button></td>
                                </tr>
                                <tr>
                                    <td>02</td>
                                    <td>GovTra</td>
                                    <td>Nilesh Manchanayaka, Keshan Fernando</td>
                                    <td>Hansini Amarathunga</td>
                                    <td><span class="badge bg-success">Ongoing</span></td>
                                    <td>20/10/2024</td>
                                    <td>20/01/2025</td>
                                    <td><button class="btn btn-success btn-sm">Edit</button></td>
                                </tr>
                                <tr>
                                    <td>03</td>
                                    <td>Doc Checking</td>
                                    <td>Nimantha Manchanayaka, Keshan Shadshindra</td>
                                    <td>Hansini Kurunasekara</td>
                                    <td><span class="badge bg-success">Ongoing</span></td>
                                    <td>02/10/2024</td>
                                    <td>23/01/2025</td>
                                    <td><button class="btn btn-success btn-sm">Edit</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
