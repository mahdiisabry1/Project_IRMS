<div class="popup-overlay" id="popupOverlay">
    <div class="card_view">
        <div class="card_view-header">
            <h2>Request Details</h2>
            <span class="close">×</span>
        </div>
        <div class="gradient-line"></div>
        <form action="/ViewRequest/SubmitRequest" method="post" enctype="multipart/form-data" id="requestForm">
            <div class="card_view-body">
                <div class="profile">
                    <img alt="Profile picture" id="popupProfileImage" height="120" src="https://placehold.co/115x117" width="120" />
                    <div class="profile-info">
                        <h3>
                            <span id="popupFirstName">Wimukthi</span>
                            <span id="popupLastName">Manchanayaka</span>
                        </h3>

                        <p id="popupDegreeDivision">
                            <span id="popupDegree">Degree Name</span> / <span id="popupDivision">Division Name</span>
                        </p>
                        <a href="#" id="editProfileLink">Edit Profile</a>
                    </div>
                </div>
                <div class="details">
                    <div class="info">
                        <p id="popupRefNo"></p>
                        <p><i class="fas fa-graduation-cap"></i><span id="popupUniversity"> National Institute of Business Management</span></p>
                        <p><i class="fas fa-phone"></i><span id="popupGender"> xxx</span></p>
                        <p><i class="fas fa-phone"></i><span id="popupContactNo"> 0765630062</span></p>
                        <p><i class="fas fa-envelope"></i><span id="popupEmail"> wimukthimanchanayaka@gmail.com</span></p>
                    </div>
                    <a class="view-cv" href="#" id="viewCVLink" target="_blank">View CV</a>
                </div>
                <div class="horizontal-line"></div>
                <div class="card_view-footer">
                    <button type="submit">Send</button>
                </div>
            </div>
            <!-- Hidden Inputs -->
            <input type="hidden" id="hiddenID" name="id" />
            <input type="hidden" id="hiddenFirstName" name="firstName" />
            <input type="hidden" id="hiddenLastName" name="lastName" />
            <input type="hidden" id="hiddenUniversity" name="university" />
            <input type="hidden" id="hiddenGender" name="gender" />
            <input type="hidden" id="hiddenContactNo" name="contactNo" />
            <input type="hidden" id="hiddenEmail" name="email" />
            <input type="hidden" id="hiddenDegree" name="degree" />
            <input type="hidden" id="hiddenDivision" name="division" />
            <input type="hidden" id="hiddenProfileImage" name="profileImage" />
            <input type="hidden" id="hiddenCV" name="cv" />

        </form>
    </div>
</div>

<div class="update-popup-overlay popup-overlay" style="display:none" id="popupOverlayUpdate">
    <div class="d-flex justify-content-center align-items-center h-100 w-100">
        <div class="card_view">
            <form action="/CreateRequest/SubmitRequest" method="post" enctype="multipart/form-data">
                <div class="card-body pt-0 mt-0">
                    <div class="row">
                        <div class="col-12 col-sm-9">
                            <hr />
                            <div class="row">
                                <div class="col-12 col-sm-6">

                                    <div class="form-group">
                                        <label>Firt Name</label>
                                        <input type="text" class="form-control" id="firstName" name="firstName" placeholder="Enter First Name" style="width:100%;  " required />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label>Last Name</label>
                                        <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Enter Last Name" style="width: 100%;  " required />

                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->

                            </div>
                            <!-- /.row -->
                            <div class="row">
                                <div class="col-12 col-sm-10">
                                    <div class="form-group">
                                        <label>University</label>
                                        <select class="form-control" id="university" name="university">
                                            <option selected>Select University</option>
                                            <option>National Institute of Buisness Management(NIBM)</option>
                                            <option>SLIT</option>
                                        </select>
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-2">
                                    <div class="form-group">
                                        <label>Gender</label>
                                        <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                                            <label class="btn btn-outline-secondary">
                                                <input type="radio" name="gender" id="male" autocomplete="off" onchange="updateProfileImage()" /> Male
                                            </label>
                                            <label class="btn btn-outline-secondary">
                                                <input type="radio" name="gender" id="female" autocomplete="off" onchange="updateProfileImage()" /> Female
                                            </label>
                                        </div>
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->

                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="email">Personal Email</label>
                                        <input type="email" class="form-control" id="email" name="email" placeholder="Enter Email" required />
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="contactNo">Contact No</label>
                                        <input type="text" class="form-control" id="contactNo" name="contactNo" placeholder="Enter Contact Number" required />

                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->

                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="degree">Degree</label>
                                        <select class="form-control" id="degree" name="degree">
                                            <option selected>Select Degree</option>
                                            <option>Bsc(Hons) Computer Science</option>
                                            <option>B.Sc. in Applied Mathematics and Computing</option>
                                        </select>
                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="division">Division</label>
                                        <select class="form-control" id="division" name="division">
                                            <option selected>Select Division</option>
                                            <option>IT</option>
                                            <option>Division B</option>
                                        </select>

                                    </div>
                                    <!-- /.form-group -->
                                </div>
                                <!-- /.col -->

                            </div>


                        </div>
                        <!--to add the profile card-->
                        <div class="col-12 col-sm-3  pt-2">

                            <div class="card shadow border-0 h-100">
                                <!--imgupload-->
                                <div class="box-card bg-dark position-relative d-flex justify-content-center align-items-center">
                                    <!-- Profile image -->
                                    <img id="profileImage"
                                         alt="Profile icon"
                                         class="rounded-circle position-absolute"
                                         src="~/Images/Group 1000002769.png"
                                         onclick="document.getElementById('imageUpload').click()"
                                         style="cursor: pointer;" />

                                    <!-- Hidden file input -->
                                    <input type="file"
                                           id="imageUpload"
                                           name="profileImage"
                                           class="d-none"
                                           accept="image/*"
                                           onchange="previewImage(event)" />
                                </div>
                                <!--end-->
                                <div class="card-body text-center d-flex flex-column justify-content-center">
                                    <h5 class="text-secondary">Upload CV Here</h5>

                                    <!-- Upload Box for the CV file -->
                                    <div class="upload-box bg-light d-flex flex-column align-items-center justify-content-center dropzone"
                                         id="uploadBox"
                                         onclick="document.getElementById('cvUpload').click();">
                                        <div class="dz-message">
                                            <i class="fas fa-upload"></i>
                                            <p class="text-secondary">Choose a file or drag & drop it here</p>
                                        </div>
                                    </div>

                                    <!-- Hidden File Input for CV -->
                                    <input type="file"
                                           id="cvUpload"
                                           name="cvFile"
                                           class="d-none"
                                           accept=".pdf, .docx, .doc, .txt"
                                           onchange="previewCV(event)" />

                                    <!-- Preview Container for CV -->
                                    <div id="filePreviewContainer" style="max-width: 400px; margin: 20px auto;">
                                        <!-- Preview will be shown here -->
                                    </div>
                                </div>

                            </div>
                        </div>


                    </div>




                </div>
                <!-- /.card-body -->

                <div class="card-footer d-flex justify-content-end">
                    <button type="submit" class="btn btn-custom">Update</button>
                </div>
            </form>
        </div>
    </div>
    
</div>

    @section Scripts {
        <script src="~/Scripts/PageScript/ViewRequest.js" type="text/javascript"></script>
    }
